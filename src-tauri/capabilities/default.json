{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability: main window plus opencode sidecar spawn scope.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/opencode",
          "sidecar": true,
          "args": [
            "serve",
            "--port",
            "4096",
            "--hostname",
            "127.0.0.1",
            "--cors",
            "tauri://localhost",
            "--cors",
            "http://tauri.localhost",
            "--cors",
            "http://localhost:5173"
          ]
        }
      ]
    }
  ]
}
